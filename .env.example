# Identifiant du client OAuth Wix Headless (Wix > Paramètres > Paramètres Headless > Créer une application OAuth).
# Ce n'est pas un secret : il est fait pour être utilisé dans le navigateur.
PUBLIC_WIX_CLIENT_ID=

# Facultatif : identifiant d'un formulaire Wix Forms pour le formulaire de contact.
# Les clés des champs se règlent dans src/config/site.ts (contactForm.fields).
PUBLIC_WIX_FORM_ID=
