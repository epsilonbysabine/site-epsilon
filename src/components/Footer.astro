---
import { sitemap, site } from '../config/site';
const year = new Date().getFullYear();
const groups = sitemap;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label="Epsilon, accueil">
          <img src="/logo/epsilon-icon.svg" alt="" width="38" height="38" />
          <span>Epsilon</span>
        </a>
        <p>{site.tagline}</p>
        <p>
          Appelez votre coach<br />
          <a href={site.phoneHref}>{site.phone}</a>
        </p>
      </div>
      {groups.map((group) => (
        <div>
          <h2>{group.label}</h2>
          <ul>
            {group.children!.map((child) => (
              <li><a href={child.href}>{child.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="footer-bottom">
      <p>© {year} {site.legalName}</p>
      <ul>
        <li><a href="/blog">Le blog Epsilon Coaching</a></li>
        <li><a href="/book-online">Réservation en ligne</a></li>
        {site.social.map((s) => (
          <li><a href={s.href} rel="noopener">{s.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <button class="back-to-top" type="button" aria-label="Remonter en haut de la page" hidden>
    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 15V5M5 10l5-5 5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <script is:inline>
    (function () {
      var btn = document.querySelector('.back-to-top');
      if (!btn) return;
      var update = function () { btn.hidden = window.scrollY < 600; };
      window.addEventListener('scroll', update, { passive: true });
      update();
      btn.addEventListener('click', function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });
    })();
  </script>
</footer>
