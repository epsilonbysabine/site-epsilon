---
import { nav, sitemap, site } from '../config/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Epsilon, accueil">
      <img src="/logo/epsilon-icon.svg" alt="" width="36" height="36" />
      <span>Epsilon</span>
    </a>
    <nav class="nav-desktop" aria-label="Navigation principale">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <a class="btn btn-primary btn-small header-cta" href="/book-online">Prendre rendez-vous</a>
      <details class="nav-mobile">
        <summary aria-label="Ouvrir le menu">
          <span class="burger" aria-hidden="true"><i></i><i></i></span>
          <span class="label-open">Menu</span>
          <span class="label-close">Fermer</span>
        </summary>
        <div class="menu-sheet">
          <nav class="wrap" aria-label="Navigation mobile">
            <ul class="menu-main">
              <li><a href="/">Accueil</a></li>
              {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            </ul>
            <div class="menu-more">
              {sitemap.slice(0, 2).map((group) => (
                <div>
                  <p class="group-title">{group.label}</p>
                  <ul>
                    {group.children.map((child) => <li><a href={child.href}>{child.label}</a></li>)}
                  </ul>
                </div>
              ))}
            </div>
            <div class="btn-row">
              <a class="btn btn-primary" href="/book-online">Prendre rendez-vous</a>
              <a class="btn btn-glass-dark" href={site.phoneHref}>Appeler le {site.phone}</a>
            </div>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
