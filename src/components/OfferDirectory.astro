---
// Liste de toutes les offres, regroupées par public.
import { offerGroups } from '../data/offers';
---
<div class="directory">
  {offerGroups.map((group) => (
    <div class="directory-group">
      <div class="directory-head">
        <h3><a href={group.href}>{group.label}</a></h3>
        <p>{group.intro}</p>
      </div>
      <ul>
        {group.items.map((item) => (
          <li>
            <a class="directory-item glass" href={item.href}>
              <strong>{item.title}</strong>
              <span>{item.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
