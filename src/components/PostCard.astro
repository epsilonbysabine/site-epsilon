---
import Bird from './Bird.astro';
import { postMeta, postHref } from '../lib/wix';
const { post } = Astro.props;
---
<a class="post-card" href={postHref(post.slug)}>
  <div class="cover">
    {post.cover ? <img src={post.cover} alt="" loading="lazy" /> : <Bird />}
  </div>
  <p class="meta">{postMeta(post)}</p>
  <h3>{post.title}</h3>
  <p>{post.excerpt}</p>
</a>
