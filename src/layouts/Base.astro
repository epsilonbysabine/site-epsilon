---
import '@fontsource-variable/manrope';
import '@fontsource-variable/figtree';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import '../styles/humain.css';
import '../styles/authentique.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactBand from '../components/ContactBand.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description?: string;
  contact?: boolean;
  image?: string;
}
const { title, description = '', contact = true, image = '/images/sabine-portrait.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// PUBLIC_VARIANT=humain ou authentique active un autre habillage (src/styles/humain.css, authentique.css).
const variantName = import.meta.env.PUBLIC_VARIANT;
const variant = variantName === 'humain' || variantName === 'authentique' ? `variant-${variantName}` : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.legalName,
  url: Astro.site?.href,
  telephone: '+33670792463',
  email: site.email,
  founder: { '@type': 'Person', name: site.coach },
  address: { '@type': 'PostalAddress', streetAddress: '260 rue du Mourelet', postalCode: '84000', addressLocality: 'Avignon', addressCountry: 'FR' },
  areaServed: 'FR',
};
---
<!doctype html>
<html lang="fr" class={variant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#4a1a92" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    {contact && <ContactBand />}
    <Footer />
  </body>
</html>
