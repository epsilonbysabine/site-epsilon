---
import Base from '../layouts/Base.astro';
import { pick } from '../lib/variant';
import { site } from '../config/site';
// Un titre par atelier, avec le thème travaillé.
const ateliers = [
  { titre: 'Oser être soi', theme: 'Confiance en soi' },
  { titre: 'Faire du stress un allié', theme: 'Gestion du stress' },
  { titre: 'Apprivoiser ses émotions', theme: 'Gestion des émotions' },
  { titre: 'Respirer pour mieux se détendre', theme: 'Relaxation et respiration' },
  { titre: 'Fixer ses objectifs… et les atteindre', theme: "Fixation d'objectifs" },
  { titre: 'Trouver et garder sa motivation', theme: 'Motivation' },
  { titre: 'Rester concentré dans un monde qui distrait', theme: 'Concentration' },
  { titre: 'Examens et oraux : se préparer sereinement', theme: 'Préparer un examen ou un oral' },
  { titre: "La charge mentale, comment s'en alléger", theme: 'Charge mentale' },
  { titre: "Prévoir, apprendre, réussir : l'art de la visualisation", theme: 'La visualisation' },
];
---
<Base
  title="Ateliers chez vous : développement personnel à domicile | Epsilon"
  description="Réunissez 6 à 10 personnes chez vous pour un atelier de développement personnel d'1 h 30 animé par Sabine Djaouane. 25 € par personne, atelier offert à l'hôte. Vaucluse, Gard, Bouches-du-Rhône, Drôme, Ardèche."
>
  <header class="page-head aura">
    <div class="wrap">
      <p class="eyebrow">Ateliers chez vous</p>
      <h1>Un atelier de développement personnel, chez vous</h1>
      <nav class="quick-links" aria-label="Dans cette page">
        <ul>
          <li><a class="glass" href="#infos">Prix et infos pratiques</a></li>
          <li><a class="glass" href="#deroulement">Comment ça marche</a></li>
          <li><a class="glass" href="#ateliers">Les ateliers</a></li>
          <li><a class="glass" href="#hote">Offert à l'hôte</a></li>
        </ul>
      </nav>
      <p class="lead">
        Réunissez vos amis, votre famille ou vos coéquipiers à la maison. Je viens animer un atelier sur le thème de votre choix, et chacun repart avec des outils concrets à utiliser au quotidien.
      </p>
      <div class="btn-row">
        <a class="btn btn-primary" href={site.phoneHref}>Organiser un atelier : {site.phone}</a>
        <a class="btn btn-glass" href="#contact">M'écrire</a>
      </div>
    </div>
  </header>

  <section class="section section-tint" id="infos">
    <div class="wrap split">
      <div class="stack sticky">
        <p class="eyebrow">En bref</p>
        <h2>{pick("L'essentiel", 'En pratique')}</h2>
      </div>
      <div class="panel-card">
        <ul class="price-list">
          <li><span>Prix</span><b>25 € par personne</b></li>
          <li><span>Groupe</span><b>De 6 à 10 personnes</b></li>
          <li><span>Durée</span><b>1 h 30, à l'horaire de votre choix</b></li>
          <li><span>Où</span><b>Vaucluse, Gard, Bouches-du-Rhône, Drôme, Ardèche</b></li>
          <li><span>Pour l'hôte</span><b>Atelier offert + 30 minutes de préparation mentale personnalisée</b></li>
        </ul>
        <p class="note">TVA non applicable.</p>
      </div>
    </div>
  </section>

  <section class="section" id="deroulement">
    <div class="wrap split">
      <div class="stack sticky">
        <p class="eyebrow">Comment ça marche</p>
        <h2>{pick('Un moment simple à organiser', 'Comment ça marche')}</h2>
      </div>
      <ol class="steps">
        <li><span><strong>Vous choisissez une date et un thème</strong>, et vous réunissez de 6 à 10 personnes chez vous.</span></li>
        <li><span><strong>Chacun apporte quelque chose à manger</strong> pour partager un moment convivial.</span></li>
        <li><span><strong>J'anime l'atelier</strong> pendant 1 h 30 : échanges, exercices pratiques et outils faciles à reprendre seul.</span></li>
        <li><span><strong>Chacun repart avec ses outils</strong> pour gagner en efficacité et en sérénité au quotidien.</span></li>
      </ol>
    </div>
  </section>

  <section class="section section-tint" id="ateliers">
    <div class="wrap split">
      <div class="stack sticky">
        <p class="eyebrow">Au choix</p>
        <h2>{pick('Les ateliers', 'Les thèmes')}</h2>
        <p>Un atelier par rencontre, choisi ensemble selon les envies de votre groupe.</p>
      </div>
      <ul class="atelier-list">
        {ateliers.map((a) => (
          <li class="glass">
            <span class="eyebrow">{a.theme}</span>
            <strong>{a.titre}</strong>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section aura" id="hote">
    <div class="wrap">
      <div class="panel-card" style="max-width: 46rem">
        <p class="eyebrow">Vous recevez ?</p>
        <h2 style="font-size: var(--step-2)">L'atelier vous est offert</h2>
        <p>
          En tant qu'hôte, vous ne payez pas votre participation, et vous bénéficiez en plus de 30 minutes de préparation mentale personnalisée.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href={site.phoneHref}>Appeler le {site.phone}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
