---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
const ateliers = [
  { title: 'Ateliers chez vous', text: 'Un atelier de développement personnel à la maison : de 6 à 10 personnes, 1 h 30, 25 € par personne, offert à l’hôte.', href: '/ateliers-chez-vous' },
  { title: 'Ateliers pour sportifs', text: 'Sept thèmes de préparation mentale à suivre au fil de la saison, indépendamment les uns des autres.', href: '/ateliers-preparation-mentale' },
  { title: 'Ateliers en entreprise', text: 'Cohésion, réunions efficaces, créativité : des ateliers sur mesure pour vos équipes.', href: '/coach-entreprise' },
  { title: 'Ateliers créativité', text: 'Workshops et brainstorming guidés pour les écoles et les entreprises.', href: '/creativite-innovation' },
];
---
<Base title="Ateliers | Epsilon" description="Les ateliers Epsilon : ateliers chez vous, ateliers de préparation mentale pour sportifs, ateliers en entreprise et ateliers créativité.">
  <PageHead
    eyebrow="Ateliers"
    title="Apprendre en groupe"
    links={ateliers.map((a) => ({ label: a.title, href: a.href }))}
    lead="Des ateliers pour repartir avec des outils concrets, à utiliser au quotidien."
  />
  <section class="section aura" style="padding-top: 1rem">
    <div class="wrap">
      <ul class="directory-list">
        {ateliers.map((a) => (
          <li><a class="directory-item glass" href={a.href}><strong>{a.title}</strong><span>{a.text}</span></a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
