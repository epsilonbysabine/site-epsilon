---
// Audios de préparation mentale : page de présentation (sortie annoncée courant janvier 2027).
// Les prix des audios ne sont pas encore fixés : voir docs/suivi-du-projet.md.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../config/site';

const extraitHref = `mailto:${site.email}?subject=${encodeURIComponent('Extrait gratuit des audios de préparation mentale')}&body=${encodeURIComponent("Bonjour Sabine,\n\nJe souhaite recevoir l'extrait gratuit des audios de préparation mentale à cette adresse e-mail.\n\nMon sport ou mon activité : \n")}`;
const infoHref = `mailto:${site.email}?subject=${encodeURIComponent('Audios de préparation mentale')}`;

const themes = [
  { titre: 'Objectifs', texte: 'Fixer des objectifs clairs et motivants, et les découper en étapes.', questions: ["Je sais précisément ce que je veux atteindre cette saison.", "Je découpe mes objectifs en étapes que je peux suivre."] },
  { titre: 'Respiration et cohérence cardiaque', texte: 'Calmer le stress, retrouver de l’énergie, mieux récupérer.', questions: ["Je sais utiliser ma respiration pour me calmer avant une épreuve.", "Je récupère facilement après un effort ou un moment de stress."] },
  { titre: 'Dialogue interne', texte: 'Transformer la petite voix qui freine en voix qui soutient.', questions: ["Quand je fais une erreur, ma petite voix intérieure m’encourage plutôt qu’elle ne me critique.", "Je sais remplacer une pensée négative par une phrase qui m’aide."] },
  { titre: 'Imagerie mentale', texte: 'Se voir réussir pour prévoir, apprendre et performer.', questions: ["Je me vois réussir avant une compétition ou une épreuve.", "J’utilise la visualisation pour apprendre ou corriger un geste."] },
  { titre: 'Posture', texte: 'Utiliser le corps pour installer confiance et présence.', questions: ["Ma posture montre de l’assurance, même quand je doute.", "Je sais utiliser mon corps pour retrouver de l’énergie ou du calme."] },
  { titre: 'Routine de performance', texte: 'Construire sa routine d’avant compétition, et s’y tenir.', questions: ["J’ai une routine précise avant chaque compétition.", "Je garde cette routine même quand les conditions changent."] },
  { titre: 'Confiance en soi et estime de soi', texte: 'S’appuyer sur ses réussites et ses ressources.', questions: ["Je crois en mes capacités à réussir ce qui compte pour moi.", "Je reconnais mes réussites, même petites."] },
  { titre: 'Motivation', texte: 'Retrouver l’envie et la garder sur toute la saison.', questions: ["J’ai envie de m’entraîner, même quand les résultats tardent.", "Je garde ma motivation tout au long de la saison."] },
  { titre: 'Gestion des émotions', texte: 'Reconnaître ses émotions et s’en servir plutôt que les subir.', questions: ["Je reste maître de mes émotions dans les moments importants.", "Après une déception, je rebondis rapidement."] },
  { titre: 'Concentration et attention', texte: 'Rester dans l’instant et ignorer ce qui distrait.', questions: ["Je reste concentré sur ce que je fais, sans me laisser distraire.", "Après une erreur, je me reconcentre tout de suite sur la suite."] },
  { titre: 'Relaxation', texte: 'Relâcher les tensions du corps et de l’esprit.', questions: ["Je sais relâcher les tensions de mon corps.", "Je m’endors facilement la veille d’une échéance importante."] },
  { titre: 'Méditation', texte: 'Apprendre à revenir au présent, simplement.', questions: ["Je sais revenir au moment présent quand mon esprit s’emballe.", "Je prends régulièrement un moment calme pour moi."] },
];

const niveaux = [
  { titre: 'Débutant', texte: 'Vous découvrez l’outil : je vous explique, nous pratiquons pas à pas.' },
  { titre: 'Intermédiaire', texte: 'Vous connaissez les bases : nous allons plus loin, avec des situations proches de votre sport.' },
  { titre: 'Confirmé', texte: 'Vous pratiquez déjà : nous affinons, pour l’utiliser au moment où ça compte.' },
];
---
<Base
  title="Audios de préparation mentale | Epsilon"
  description="Des audios d'environ 1 heure, comme une vraie séance de préparation mentale : 12 thèmes, 3 niveaux, avec ou sans suivi. Disponibles courant janvier 2027."
>
  <PageHead
    eyebrow="Audios"
    title="Audios de préparation mentale"
    lead="Des séances d’environ 1 heure à écouter chez vous, comme une vraie séance avec moi : des explications, des exemples concrets et des exercices pour travailler par vous-même. Disponibles courant janvier 2027."
    cta={false}
    links={[
      { label: 'Comment ça marche', href: '#principe' },
      { label: 'L’autotest', href: '#test' },
      { label: 'Les 12 thèmes', href: '#themes' },
      { label: 'Trois niveaux', href: '#niveaux' },
      { label: 'Les formules', href: '#formules' },
      { label: 'Extrait gratuit', href: '#extrait' },
    ]}
  >
    <div class="btn-row">
      <a class="btn btn-primary" href={extraitHref}>Recevoir l’extrait gratuit</a>
      <a class="btn btn-glass" href="#formules">Voir les formules</a>
    </div>
  </PageHead>

  <section class="section section-tint" id="principe">
    <div class="wrap split">
      <div class="stack sticky">
        <h2>Comment ça marche</h2>
        <p>Chaque audio est une séance complète. Prévoyez un endroit calme, un carnet et un stylo.</p>
      </div>
      <ol class="steps">
        <li><span><strong><a href="#test">Faites l’autotest</a></strong> : il vous aide à voir où vous en êtes et quels thèmes travailler en priorité.</span></li>
        <li><span><strong>Choisissez vos audios</strong> et votre niveau : débutant, intermédiaire ou confirmé.</span></li>
        <li><span><strong>Écoutez et pratiquez</strong> : chaque séance alterne explications, exemples et temps de travail personnel.</span></li>
        <li><span><strong>Reprenez les exercices</strong> à l’entraînement et en compétition, jusqu’à ce qu’ils deviennent des réflexes.</span></li>
      </ol>
    </div>
  </section>

  <section class="section" id="test">
    <div class="wrap">
      <div class="section-head">
        <h2>L’autotest : par où commencer ?</h2>
        <p class="lead">24 affirmations, environ 5 minutes. Pour chacune, indiquez si elle vous ressemble, de 1 (pas du tout) à 5 (tout à fait). Le résultat vous indique les thèmes et le niveau à travailler en priorité.</p>
      </div>
      <form class="quiz" id="quiz" novalidate>
        {themes.map((t, ti) => t.questions.map((q, qi) => {
          const name = `q${ti}-${qi}`;
          return (
            <fieldset class="quiz-item" data-theme={ti}>
              <legend><span class="quiz-num">{ti * 2 + qi + 1}.</span> {q}</legend>
              <div class="quiz-scale">
                <span class="quiz-end" aria-hidden="true">Pas du tout</span>
                {[1, 2, 3, 4, 5].map((v) => (
                  <label><input type="radio" name={name} value={v} aria-label={`${v} sur 5`} /><span>{v}</span></label>
                ))}
                <span class="quiz-end" aria-hidden="true">Tout à fait</span>
              </div>
            </fieldset>
          );
        }))}
        <p class="quiz-error" id="quiz-error" role="alert" hidden></p>
        <p><button class="btn btn-primary" type="submit">Voir mon résultat</button></p>
      </form>
      <div class="quiz-result panel-card" id="quiz-result" tabindex="-1" hidden>
        <p class="eyebrow">Votre résultat</p>
        <h3>Vos 3 thèmes prioritaires</h3>
        <ol class="steps" id="quiz-list"></ol>
        <p>Cet autotest vous donne une première orientation pour choisir vos audios. Pour une analyse beaucoup plus précise, je vous conseille le <a href="/preparation-mentale#bilan">Bilan de vos ressources</a> : entretien, tests approfondis et compte rendu personnalisé.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="#formules">Voir les formules</a>
          <button class="btn btn-glass" type="button" id="quiz-reset">Refaire l’autotest</button>
        </div>
      </div>
      <script is:inline define:vars={{ titres: themes.map((t) => t.titre) }}>
        (function () {
          var form = document.getElementById('quiz');
          var result = document.getElementById('quiz-result');
          var list = document.getElementById('quiz-list');
          var error = document.getElementById('quiz-error');
          if (!form) return;
          function niveau(score) { return score <= 5 ? 'débutant' : score <= 8 ? 'intermédiaire' : 'confirmé'; }
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            var scores = titres.map(function () { return 0; });
            var missing = [];
            form.querySelectorAll('.quiz-item').forEach(function (fs, i) {
              var checked = fs.querySelector('input:checked');
              fs.classList.toggle('is-missing', !checked);
              if (!checked) missing.push(i + 1); else scores[+fs.dataset.theme] += +checked.value;
            });
            if (missing.length) {
              error.textContent = 'Il reste ' + missing.length + (missing.length > 1 ? ' affirmations' : ' affirmation') + ' sans réponse' + (missing.length <= 5 ? ' (n° ' + missing.join(', ') + ').' : '.');
              error.hidden = false;
              form.querySelector('.is-missing input').focus();
              return;
            }
            error.hidden = true;
            var order = scores.map(function (s, i) { return [s, i]; }).sort(function (a, b) { return a[0] - b[0] || a[1] - b[1]; }).slice(0, 3);
            list.innerHTML = '';
            order.forEach(function (o) {
              var li = document.createElement('li');
              var span = document.createElement('span');
              var strong = document.createElement('strong');
              strong.textContent = titres[o[1]];
              span.appendChild(strong);
              span.appendChild(document.createTextNode(' : niveau ' + niveau(o[0])));
              li.appendChild(span);
              list.appendChild(li);
            });
            result.hidden = false;
            result.focus();
          });
          form.addEventListener('change', function (e) {
            var fs = e.target.closest('.quiz-item');
            if (fs) fs.classList.remove('is-missing');
          });
          document.getElementById('quiz-reset').addEventListener('click', function () {
            form.reset();
            result.hidden = true;
            form.querySelector('input').focus();
          });
        })();
      </script>
    </div>
  </section>

  <section class="section section-tint" id="themes">
    <div class="wrap">
      <div class="section-head">
        <h2>Les 12 thèmes</h2>
        <p class="lead">Chaque thème est un audio d’environ 1 heure, décliné en trois niveaux.</p>
      </div>
      <ul class="atelier-list trio">
        {themes.map((t) => (
          <li class="glass">
            <strong>{t.titre}</strong>
            <span class="atelier-text">{t.texte}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="niveaux">
    <div class="wrap">
      <div class="section-head">
        <h2>Trois niveaux pour chaque thème</h2>
        <p class="lead">Vous avancez à votre rythme, du premier pas jusqu’à la maîtrise de l’outil.</p>
      </div>
      <ul class="atelier-list trio">
        {niveaux.map((n, i) => (
          <li class="glass">
            <span class="eyebrow">Niveau {i + 1}</span>
            <strong>{n.titre}</strong>
            <span class="atelier-text">{n.texte}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-tint" id="formules">
    <div class="wrap">
      <div class="section-head">
        <h2>Deux formules</h2>
        <p class="lead">Avec ou sans moi à vos côtés.</p>
      </div>
      <div class="grid-2">
        <div class="panel-card stack">
          <h3>Audios</h3>
          <p>Vous faites le test seul, puis vous choisissez vos audios. Aucune séance n’est incluse, sauf si vous en ressentez le besoin. Les audios peuvent aussi être le point de départ d’un accompagnement plus approfondi.</p>
          <ul class="price-list">
            <li><span>Prix</span><b>Tarifs communiqués courant janvier 2027</b></li>
          </ul>
        </div>
        <div class="panel-card stack">
          <h3>Audios + suivi</h3>
          <p>Un accompagnement de 4 mois, avec moi :</p>
          <ol class="steps">
            <li><span><strong>Séance d’1 h 30 par téléphone</strong> pour faire les tests ensemble.</span></li>
            <li><span><strong>Vos audios</strong>, choisis selon les résultats.</span></li>
            <li><span><strong>Point téléphonique de 30 minutes</strong> au bout de 2 mois.</span></li>
            <li><span><strong>Séance de clôture de 30 minutes</strong> à la fin des 4 mois.</span></li>
          </ol>
          <ul class="price-list">
            <li><span>Étudiant, sportif d’un club partenaire</span><b>Prix des audios + 225 €</b></li>
            <li><span>Salarié et autres</span><b>Prix des audios + 285 €</b></li>
          </ul>
          <p class="note">Le suivi représente 3 heures de mon temps (séances et analyse de vos tests), au tarif horaire de 75 € ou 95 €. TVA non applicable.</p>
        </div>
      </div>
      <p class="note" style="margin-top: 1.25rem">Vos audios sont personnels : l’accès est réservé à la personne qui les a achetés et ne peut pas être transmis.</p>
    </div>
  </section>

  <section class="section" id="extrait">
    <div class="wrap grid-2">
      <div class="panel-card stack">
        <p class="eyebrow">Bonus</p>
        <h2 style="font-size: var(--step-2)">Des bonus audio et leurs petits outils</h2>
        <p>Des audios courts, accompagnés d’un petit outil à garder sous la main. Par exemple, une <strong>routine respiratoire du soir</strong> d’environ 10 minutes, avec le carré magique et la cohérence cardiaque, pour mieux dormir.</p>
      </div>
      <div class="panel-card stack">
        <p class="eyebrow">Extrait gratuit</p>
        <h2 style="font-size: var(--step-2)">Écoutez un extrait avant de choisir</h2>
        <p>Laissez-moi votre adresse e-mail : je vous envoie un extrait gratuit dès la sortie des audios, courant janvier 2027.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={extraitHref}>Recevoir l’extrait gratuit</a>
          <a class="btn btn-glass" href={infoHref}>Poser une question</a>
        </div>
      </div>
    </div>
  </section>
</Base>
