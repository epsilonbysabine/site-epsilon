---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { testimonials, clientLogos } from '../data/testimonials';
---
<Base
  title="Ils m'ont fait confiance pour leur coaching et preparation mentale - Epsilon"
  description="Coaching84: ils nous ont fait confiance à travers l'héxagone - coaching, préparation mentale, formation en créativité et communication"
>
  <PageHead eyebrow="Mes clients" title="Ils me font confiance" />
  <section class="section aura" style="padding-top: 1rem">
    <div class="wrap stack-lg">
      <ul class="logos">
        {clientLogos.map((logo) => <li><img src={logo.src} alt={logo.alt} loading="lazy" /></li>)}
      </ul>
      <div class="quotes">
        {testimonials.map((t) => (
          <blockquote class="quote glass">
            {t.paragraphs.map((p) => <p>{p}</p>)}
            <cite>{t.author}</cite>
          </blockquote>
        ))}
      </div>
    </div>
  </section>
</Base>
