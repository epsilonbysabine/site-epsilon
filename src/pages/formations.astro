---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CreativityQuotes from '../components/CreativityQuotes.astro';
import { site } from '../config/site';
const devisHref = `mailto:${site.email}?subject=${encodeURIComponent('Formation créativité et communication')}`;
const modules = [
  { titre: 'Ateliers de créativité', points: ['Brainstorming, mind mapping, les six chapeaux de De Bono, pensée divergente', 'Trouver des solutions innovantes à des problèmes complexes'] },
  { titre: 'Communication', points: ['Prise de parole et présentation', 'Communication interpersonnelle', 'Gagner en impact et en clarté, y compris sur des sujets techniques'] },
  { titre: 'Projets pratiques', points: ['Mise en application sur des cas concrets', 'Travail en équipe, comme en entreprise'] },
];
---
<Base audience="entreprises"
  title="Epsilon Coaching - Formation en Créativité et Communication"
  description={'Je vous accompagne dans vos formations : entreprise ou école post-bac, je vous propose une formation inédite "créativité et communication"'}
>
  <PageHead audience="entreprises"
    links={[
      { label: 'Créativité & communication', href: '#creativite' },
      { label: 'Écoles post-bac', href: '#ecoles' },
      { label: 'Recommandations', href: '#avis' },
      { label: 'Autres formations', href: '#autres' },
      { label: 'Créativité et innovation', href: '/creativite-innovation' },
    ]}
    eyebrow="Formations"
    title="Formations créativité & communication"
    lead="La formation « Créativité et communication » donne des résultats concrets et mesurables dans la vie professionnelle. Je la propose aux entreprises et aux écoles post-bac."
  />
  <section class="section section-tint" id="creativite">
    <div class="wrap split">
      <div class="prose sticky">
        <p>
          C'est un outil de développement du potentiel des étudiants et des salariés. Elle apporte des résultats en augmentant l’efficacité et en donnant aux individus et aux équipes les moyens de réussir :
        </p>
      </div>
      <ul class="prose">
        <li>Méthodologie des différentes techniques de créativité</li>
        <li>Augmentation du potentiel d’écoute pour mieux communiquer</li>
        <li>Communication facilitée dans le groupe</li>
        <li>Dépassement des habitudes ou des comportements limitants: sortie de sa zone de confort</li>
        <li>Augmentation de la confiance du stagiaire dans sa créativité</li>
        <li>Vision positive des idées des autres et des siennes (ouverture d’esprit)</li>
        <li>Proposition de cas pratiques avec mise en situation par les stagiaires tout au long de la formation</li>
      </ul>
    </div>
  </section>
  <section class="section" id="ecoles">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Écoles post-bac</p>
        <h2>Créativité et communication pour vos étudiants</h2>
        <p class="lead">Depuis 10 ans, j'enseigne la créativité et la communication à l'IMT Lille Douai (aujourd'hui IMT Nord Europe), école d'ingénieurs. Des centaines d'étudiants ont suivi cette formation, avec plus de 90&nbsp;% de satisfaction globale.</p>
      </div>
      <ul class="atelier-list trio">
        {modules.map((m) => (
          <li class="glass">
            <strong>{m.titre}</strong>
            <ul>{m.points.map((pt) => <li>{pt}</li>)}</ul>
          </li>
        ))}
      </ul>
      <p style="margin-top: 1.5rem; max-width: 46rem">Le contenu et la durée s'adaptent à votre école et à votre programme. Chaque session se termine par une évaluation, pour mesurer ce que les étudiants en retirent.</p>
      <p style="margin-top: 1rem"><a class="btn btn-primary" href={devisHref}>Demander un devis</a></p>
    </div>
  </section>
  <CreativityQuotes />
  <section class="section" id="autres">
    <div class="wrap split">
      <div class="stack">
        <h2>Suivant vos besoins</h2>
        <p>Je vous propose des formations sur :</p>
      </div>
      <div class="stack">
        <ul class="tags">
          <li>la communication</li>
          <li>la créativité</li>
          <li>le management</li>
          <li>la PNL</li>
          <li>la préparation mentale</li>
          <li>la gestion de stress</li>
        </ul>
        <p>
          Pour plus d'informations sur ma formation « créativité et communication » contactez votre <a href="/coach-entreprise">coach en entreprise</a> via le formulaire de <a href="#contact">contact</a>.
        </p>
        <p><a class="text-link" href="/creativite-innovation">Créativité et innovation pour les écoles et les entreprises</a></p>
      </div>
    </div>
  </section>
</Base>
