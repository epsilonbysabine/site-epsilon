---
import Base from '../layouts/Base.astro';
import OfferDirectory from '../components/OfferDirectory.astro';
import { clientLogos } from '../data/testimonials';

const quotes = [
  {
    text: "Sabine a su me faire prendre conscience que les solutions étaient en moi, ce qui m'a permis de corriger de moi même, d'analyser et de me recentrer.",
    author: 'Boris, coaching particulier',
  },
  {
    text: "Depuis plus de 7 ans, nous faisons appel aux compétences de Sabine. Une approche bienveillante, une écoute attentive et un accompagnement professionnel essentiel.",
    author: 'Entreprise Moro Prato, entretiens professionnels et QVCT',
  },
  {
    text: 'Donne confiance en soi, donne des techniques de respiration pour gérer le stress dont je me sers aussi bien pour le sport que pour mon baccalauréat.',
    author: 'Sully, sportif en jiu-jitsu brésilien',
  },
];
---
<Base
  title="Epsilon by Sabine | Préparation mentale et coaching, Avignon"
  description="Préparatrice mentale et coach à Avignon : sportifs, étudiants, entreprises. Séances individuelles, ateliers, formations. Premier entretien de 30 min offert."
  image="/images/sabine-portrait-2.jpg"
>
  <!-- 1. Héros -->
  <section class="hero dark aura">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>
          <span class="kicker">Préparation mentale et coaching · Avignon et partout en France</span>
          <span class="display">Libérez et développez votre performance.</span>
        </h1>
        <p class="lead">
          Plus qu'une préparation ponctuelle, un apprentissage de tous les jours : mieux vous analyser, maîtriser vos outils, gagner en efficacité et performer, dans votre métier comme dans votre discipline.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/book-online">Réserver mon entretien offert de 30&nbsp;min</a>
          <a class="btn btn-glass-dark" href="#offres">Voir ce que nous proposons</a>
        </div>
        <ul class="proof">
          <li>Interventions partout en France</li>
        </ul>
      </div>
      <figure class="hero-portrait" style="margin: 0">
        <div class="frame glass-dark">
          <img src="/images/sabine-portrait-2.jpg" alt="Sabine Djaouane, préparatrice mentale et coach" width="800" height="1200" fetchpriority="high" />
        </div>
        <figcaption class="portrait-card glass-dark">
          <strong>Sabine Djaouane</strong>
          <span>Préparatrice mentale et coach, Avignon</span>
          <q>Vous avez déjà tout en vous pour réussir.</q>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 2. Toutes les offres -->
  <section class="section aura" id="offres">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Ce que nous proposons</p>
        <h2>Trouvez l'accompagnement qui vous correspond</h2>
      </div>
      <OfferDirectory />
    </div>
  </section>

  <!-- 3. Ils nous font confiance -->
  <section class="logo-strip" aria-label="Ils nous font confiance">
    <div class="wrap">
      <p>Ils nous font confiance</p>
      <ul class="logo-row">
        {clientLogos.map((logo) => <li><img src={logo.src} alt={logo.alt} loading="lazy" /></li>)}
      </ul>
    </div>
  </section>

  <!-- 4. Témoignages -->
  <section class="section aura">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Témoignages</p>
        <h2>Ce qu'en disent les personnes accompagnées</h2>
      </div>
      <div class="quote-grid">
        {quotes.map((q) => (
          <blockquote class="quote-card glass">
            <p>« {q.text} »</p>
            <cite>{q.author}</cite>
          </blockquote>
        ))}
      </div>
      <p style="margin-top: 2rem"><a class="text-link" href="/clients">Tous les témoignages</a></p>
    </div>
  </section>
</Base>
