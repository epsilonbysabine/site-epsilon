---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, postMeta } from '../../lib/wix';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const others = (await getPosts()).filter((p) => p.slug !== post.slug).slice(0, 3);
---
<Base title={post.title} description={post.excerpt} image={post.cover ?? undefined}>
  <article class="section" style="padding-bottom: 2rem">
    <div class="wrap">
      <div class="article">
        <p class="crumb"><a href="/blog">Tous les posts</a></p>
        <h1>{post.title}</h1>
        <p class="meta" style="margin-top: 1rem">
          {['Sabine Djaouane', postMeta(post)].filter(Boolean).join(' · ')}
        </p>
        {post.cover && <img class="cover" src={post.cover} alt="" />}
        <div class="prose" style={post.cover ? undefined : 'margin-top: 2rem'} set:html={post.html} />
      </div>
    </div>
  </article>
  {others.length > 0 && (
    <section class="section section-tint">
      <div class="wrap stack-lg">
        <h2>Posts récents</h2>
        <div class="post-list three">
          {others.map((p) => <PostCard post={p} />)}
        </div>
      </div>
    </section>
  )}
</Base>
